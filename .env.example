## Docker Compose environment for camel
##
## Compose automatically loads this file when you run `docker compose ...`
## in the same directory as `compose.yaml`.

# Postgres connection (used by cmd/portfolio-manager/config.go)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=camel
POSTGRES_PASSWORD=camel
POSTGRES_DATABASE=camel
POSTGRES_SSLMODE=disable

# Alpaca credentials (required for market data / rebalance)
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional overrides
ALPACA_MARKETDATA_URL=https://data.alpaca.markets
